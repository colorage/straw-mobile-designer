# Optional. The app defaults to the shared pawuk-app Supabase project, so a
# plain `npm run dev` already has working accounts. Set these to point a fork at
# a different project — see supabase/README.md for the required schema and auth
# settings.
#
# The anon/publishable key is safe in the browser: it ships in the built bundle
# either way, and access control comes from Row Level Security.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
