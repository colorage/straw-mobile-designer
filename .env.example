# Supabase project for the community gallery (publish / browse / like).
# Copy to .env (or .env.local) and fill in from your Supabase project's
# API settings. Both values are safe to embed in the client bundle.
# Leave unset to run fully local: the designer and personal gallery work
# without them, and community features hide themselves.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
